{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/status"],

    "group/status": {
        "orientation": "horizontal",
        "modules": ["hyprland/language", "pulseaudio", "network", "bluetooth"]
    },

    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰘔",
        "window-rewrite": {
            "class<firefox>": "",
            "class<TelegramDesktop>": "",
            "class<com.mitchellh.ghostty>": "",
            "class<discord>": "",
            "class<com.github.xournalpp.xournalpp>": "󰏪",
            "class<libreoffice-.*>": "",
            "class<obs>": "󰑋",
            "class<com.obsproject.Studio>": "󰑋"
        },
        "tooltip": false,
	"on-click": "activate"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false
    },

    "hyprland/language": {
        "format": "{short}",
        "tooltip": false,
        "on-click": "hyprctl switchxkblayout all next"
    },

    "pulseaudio": {
        "format": " ",
        "format-muted": " ",
        "states": {
            "low": 33,
            "medium": 99,
            "high": 100
        },
        "scroll-step": 5.0,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": " ",
        "format-disconnected": " ",
        "tooltip": false
    },

    "bluetooth": {
        "format": " ",
        "format-connected": " ",
        "tooltip": false
    }
}
