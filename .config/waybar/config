{
    "layer": "top",
    "position": "top",
    "modules-left": ["custom/sysmenu", "custom/menu", "custom/files", "custom/clipboard", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/status"],

    "group/status": {
        "orientation": "horizontal",
        "modules": ["hyprland/language", "pulseaudio", "network", "bluetooth"]
    },

    "custom/sysmenu": {
        "format": " ",
        "tooltip": false,
        "on-click": "~/.config/scripts/rofi_sysmenu_launcher.sh"
    },

    "custom/menu": {
        "format": " ",
        "tooltip": false,
        "on-click": "~/.config/scripts/rofi_menu_launcher.sh"
    },

    "custom/files": {
        "format": " ",
        "tooltip": false,
        "on-click": "alacritty -e \"$SHELL\" -ic \"y\""
    },

    "custom/clipboard": {
        "format": " ",
        "tooltip": false,
        "on-click": "~/.config/scripts/rofi_clipboard_launcher.sh"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "tooltip": false,
	"on-click": "activate"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false
    },

    "hyprland/language": {
        "format": "{short}",
        "tooltip": false,
        "on-click": "hyprctl switchxkblayout all next"
    },

    "pulseaudio": {
        "format": " ",
        "format-muted": " ",
        "states": {
            "low": 33,
            "medium": 99,
            "high": 100
        },
        "scroll-step": 5.0,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": " ",
        "format-disconnected": " ",
        "tooltip": false
    },

    "bluetooth": {
        "format": " ",
        "format-connected": " ",
        "tooltip": false
    }
}
